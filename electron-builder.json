{
  "appId": "com.markdownvision.reader",
  "productName": "Markdown Vision",
  "directories": {
    "output": "dist"
  },
  "files": [
    "index.html",
    "styles.css",
    "app.js",
    "main.cjs",
    "preload.cjs",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "MarkdownVision-Setup-${version}.${ext}"
  },
  "fileAssociations": [
    {
      "ext": [
        "md",
        "markdown",
        "mdown",
        "mkd"
      ],
      "name": "Markdown document",
      "role": "Viewer"
    }
  ],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
