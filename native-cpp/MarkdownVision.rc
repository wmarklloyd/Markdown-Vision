#include <windows.h>

1 RT_MANIFEST "MarkdownVision.manifest"
101 ICON "MarkdownVision.ico"

1 VERSIONINFO
 FILEVERSION 2,4,0,0
 PRODUCTVERSION 2,4,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Markdown Vision\0"
            VALUE "FileVersion", "2.4.0\0"
            VALUE "OriginalFilename", "Markdown-Vision.exe\0"
            VALUE "ProductName", "Markdown Vision\0"
            VALUE "ProductVersion", "2.4.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
