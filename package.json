{
  "name": "markdown-vision",
  "version": "2.8.22",
  "description": "Markdown Vision",
  "main": "src/electron/main.cjs",
  "author": "Markdown Vision",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "installer": "electron-builder --win nsis",
    "installer-native": "native-cpp\\build-installer.bat",
    "dist-native": "powershell -ExecutionPolicy Bypass -File native-windows\\build.ps1",
    "dist-native-self-contained": "powershell -ExecutionPolicy Bypass -File native-windows\\build-self-contained.ps1"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.markdownvision.reader",
    "productName": "Markdown Vision",
    "asar": true,
    "compression": "maximum",
    "icon": "build/icon",
    "files": [
      "src/web/index.html",
      "src/web/styles.css",
      "src/web/vendor/**/*",
      "src/web/fonts/**/*",
      "src/web/app.js",
      "src/web/editor-ui.js",
      "src/electron/main.cjs",
      "src/electron/preload.cjs"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown document",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "MarkdownVision-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "MarkdownVision-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
